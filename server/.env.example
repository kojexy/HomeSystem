# Copy to .env (start.sh does it) and fill in. .env is never committed.

# Your time zone, e.g. Asia/Shanghai, Europe/Moscow
TZ=UTC

# Camera login (Tapo app → camera → Advanced settings → Camera account)
FRIGATE_RTSP_USER=
FRIGATE_RTSP_PASSWORD=

# AI descriptions of camera events. Free key: https://aistudio.google.com/apikey
FRIGATE_GEMINI_API_KEY=

# Where 24/7 video is kept. Use the big disk, e.g. /mnt/storage/frigate
RECORDINGS_DIR=./recordings

# Extras to start: cloud, local-ai (comma separated)
COMPOSE_PROFILES=

# Cloud folder for event backups (after: docker compose run --rm --entrypoint rclone cloud-backup config)
# e.g. gdrive:HomeSystem   dropbox:HomeSystem   yandex:HomeSystem
CLOUD_REMOTE=
